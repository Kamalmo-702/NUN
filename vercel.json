{
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "data/**,models/**"
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend"
    }
  ]
}
